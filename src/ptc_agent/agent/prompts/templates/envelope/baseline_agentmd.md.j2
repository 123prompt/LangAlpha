{# Rendered into the cached per-thread baseline: byte-deterministic for equal
   inputs, so no timestamps, no dict iteration, and no guidance fence. #}
<agentmd path="{{ path | default("/agent.md") }}">
{% if content %}
{{ content }}
{% else %}
No agent.md exists yet. Create /agent.md at the workspace root with the workspace purpose, the initial goals and planned artifacts, and section stubs for Thread Index, Key Findings, File Index.
{% endif %}
</agentmd>
